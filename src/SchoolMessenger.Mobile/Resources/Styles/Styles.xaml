<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <Style TargetType="Label"><Setter Property="TextColor" Value="#182C47" /><Setter Property="FontSize" Value="14" /></Style>
    <Style TargetType="Button">
        <Setter Property="TextColor" Value="#182C47" /><Setter Property="BackgroundColor" Value="White" /><Setter Property="FontSize" Value="14" />
        <Setter Property="CornerRadius" Value="12" /><Setter Property="Padding" Value="14,10" /><Setter Property="MinimumHeightRequest" Value="44" /><Setter Property="MinimumWidthRequest" Value="44" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList><VisualStateGroup x:Name="CommonStates"><VisualState x:Name="Normal" /><VisualState x:Name="Disabled"><VisualState.Setters><Setter Property="Opacity" Value="0.45" /></VisualState.Setters></VisualState></VisualStateGroup></VisualStateGroupList>
        </Setter>
    </Style>
    <Style TargetType="Entry"><Setter Property="TextColor" Value="#182C47" /><Setter Property="PlaceholderColor" Value="#5A6B82" /><Setter Property="BackgroundColor" Value="Transparent" /><Setter Property="FontSize" Value="14" /><Setter Property="MinimumHeightRequest" Value="44" /></Style>
    <Style TargetType="Editor"><Setter Property="TextColor" Value="#182C47" /><Setter Property="PlaceholderColor" Value="#5A6B82" /><Setter Property="BackgroundColor" Value="White" /><Setter Property="FontSize" Value="14" /></Style>
    <Style TargetType="Picker"><Setter Property="TextColor" Value="#182C47" /><Setter Property="TitleColor" Value="#5A6B82" /><Setter Property="FontSize" Value="13" /><Setter Property="MinimumHeightRequest" Value="44" /></Style>
    <Style TargetType="DatePicker"><Setter Property="TextColor" Value="#182C47" /><Setter Property="FontSize" Value="14" /><Setter Property="MinimumHeightRequest" Value="44" /></Style>
    <Style TargetType="CheckBox"><Setter Property="Color" Value="#245BC6" /><Setter Property="MinimumHeightRequest" Value="44" /><Setter Property="MinimumWidthRequest" Value="44" /></Style>
    <Style TargetType="Switch"><Setter Property="OnColor" Value="#EAF0FC" /><Setter Property="ThumbColor" Value="#245BC6" /><Setter Property="MinimumHeightRequest" Value="44" /></Style>
    <Style TargetType="ActivityIndicator"><Setter Property="Color" Value="#245BC6" /></Style>
    <Style TargetType="Page" ApplyToDerivedTypes="True"><Setter Property="BackgroundColor" Value="#F3F6FB" /></Style>
    <Style TargetType="NavigationPage"><Setter Property="BarBackgroundColor" Value="White" /><Setter Property="BarTextColor" Value="#182C47" /><Setter Property="IconColor" Value="#182C47" /></Style>
</ResourceDictionary>